# ============================================
# CORE CONFIGURATION (REQUIRED)
# ============================================

# Supabase Configuration (REQUIRED)
# Get these values from: https://app.supabase.com/project/_/settings/api
# - NEXT_PUBLIC_SUPABASE_URL: Your project URL (e.g., https://xxxxx.supabase.co)
# - NEXT_PUBLIC_SUPABASE_ANON_KEY: Public anon key (safe to expose in frontend)
# - SUPABASE_SERVICE_ROLE_KEY: Service role key (KEEP SECRET, server-side only)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application Configuration (REQUIRED)
# - NODE_ENV: Environment (development, production, test)
# - NEXT_PUBLIC_APP_URL: Full URL of your application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# ERROR MONITORING & ANALYTICS (REQUIRED FOR PRODUCTION)
# ============================================

# Sentry Configuration (Error Monitoring)
# Get your DSN from: https://sentry.io/settings/projects/
# Required for production error tracking and monitoring (Req 15.1, 16.8)
# - NEXT_PUBLIC_SENTRY_DSN: Public DSN for client-side error reporting
# - SENTRY_AUTH_TOKEN: Authentication token for source map uploads (build-time only)
# - SENTRY_ORG: Your Sentry organization slug
# - SENTRY_PROJECT: Your Sentry project name
# - NEXT_PUBLIC_SENTRY_RELEASE: Optional release identifier (defaults to git commit SHA if not set)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_RELEASE=

# Vercel Analytics (Performance Monitoring)
# Enabled by default when deployed on Vercel
# Set to 'false' to disable analytics tracking
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=true

# ============================================
# PAYMENT INTEGRATION (REQUIRED FOR TRANSACTIONS)
# ============================================

# Paystack Configuration (Payment Processing)
# Get keys from: https://dashboard.paystack.com/#/settings/developers
# - NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY: Public key (safe for frontend)
# - PAYSTACK_SECRET_KEY: Secret key (KEEP SECRET, server-side only)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# ============================================
# STORAGE & MEDIA (REQUIRED FOR IMAGE UPLOADS)
# ============================================

# Cloudinary Configuration (Image Storage & Optimization)
# Get credentials from: https://console.cloudinary.com/
# Required for image uploads and transformations
# - NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME: Your cloud name
# - CLOUDINARY_API_KEY: API key for server-side operations
# - CLOUDINARY_API_SECRET: API secret (KEEP SECRET)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ============================================
# SEARCH & DISCOVERY (OPTIONAL)
# ============================================

# Typesense Configuration (Search Engine)
# Get credentials from: https://cloud.typesense.org/
# Optional: Enhanced search functionality
NEXT_PUBLIC_TYPESENSE_HOST=localhost
NEXT_PUBLIC_TYPESENSE_PORT=8108
NEXT_PUBLIC_TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=your_typesense_api_key

# ============================================
# COMMUNICATION (OPTIONAL)
# ============================================

# Resend Configuration (Email Service)
# Get API key from: https://resend.com/api-keys
# Required for transactional emails (notifications, password reset)
RESEND_API_KEY=your_resend_api_key

# Twilio Configuration (SMS OTP)
# Get credentials from: https://console.twilio.com/
# Optional: SMS verification and notifications
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ============================================
# LOCATION SERVICES (OPTIONAL)
# ============================================

# Mapbox Configuration (Maps & Geolocation)
# Get access token from: https://account.mapbox.com/access-tokens/
# Optional: Map display and location search
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# ============================================
# RATE LIMITING (RECOMMENDED FOR PRODUCTION)
# ============================================

# Upstash Redis Configuration (Rate Limiting)
# Get credentials from: https://console.upstash.com/
# Recommended for API rate limiting in production
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ============================================
# AI & MODERATION (OPTIONAL)
# ============================================

# OpenAI Configuration (AI Content Moderation)
# Get API key from: https://platform.openai.com/api-keys
# Optional: Automated content moderation
OPENAI_API_KEY=your_openai_api_key

# ============================================
# ADVANCED ANALYTICS (OPTIONAL)
# ============================================

# PostHog Configuration (User Behavior Analytics & A/B Testing)
# Get credentials from: https://app.posthog.com/project/settings
# Optional: Advanced user analytics and feature flags
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_POSTHOG_RECORDING=false

# ============================================
# LIVE STREAMING (OPTIONAL - FUTURE FEATURE)
# ============================================

# Live Streaming Configuration
# Choose streaming service: 'agora', 'mux', or 'mock' (for development)
STREAMING_SERVICE=mock

# Agora Configuration (Recommended for Nigerian market)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Mux Configuration (Alternative streaming service)
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret

# ============================================
# LOGISTICS PARTNERS (OPTIONAL - FUTURE FEATURE)
# ============================================

# GIG Logistics
GIG_API_KEY=your_gig_api_key
GIG_API_SECRET=your_gig_api_secret
GIG_API_ENDPOINT=https://api.giglogistics.com

# Kwik Delivery
KWIK_API_KEY=your_kwik_api_key
KWIK_API_SECRET=your_kwik_api_secret
KWIK_API_ENDPOINT=https://api.kwikdelivery.com

# Sendbox
SENDBOX_API_KEY=your_sendbox_api_key
SENDBOX_API_SECRET=your_sendbox_api_secret
SENDBOX_API_ENDPOINT=https://api.sendbox.co

# Gokada
GOKADA_API_KEY=your_gokada_api_key
GOKADA_API_SECRET=your_gokada_api_secret
GOKADA_API_ENDPOINT=https://api.gokada.ng

# Redbox Logistics
REDBOX_API_KEY=your_redbox_api_key
REDBOX_API_SECRET=your_redbox_api_secret
REDBOX_API_ENDPOINT=https://api.redboxlogistics.com

# Bolt
BOLT_API_KEY=your_bolt_api_key
BOLT_API_SECRET=your_bolt_api_secret
BOLT_API_ENDPOINT=https://api.bolt.eu
